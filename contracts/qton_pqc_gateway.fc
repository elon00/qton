;; QTON Post-Quantum Cryptography (PQC) On-Chain Gateway
;; Verifies off-chain NIST FIPS 204 ML-DSA-65 state attestations via Commit-Reveal & Sequence Invariants
#pragma version >=0.4.0;

#include "imports/stdlib.fc";
#include "params.fc";
#include "op-codes.fc";

;; Storage:
;; pqc_operator_key: uint256 (Public commitment of authorized PQC signer)
;; last_seqno: uint64 (Monotonically increasing sequence number against replay)
;; state_root_hash: uint256 (Current post-quantum verified state root)
;; timelock_address: MsgAddressInt (Timelock/Master destination)

(int, int, int, slice) load_data() inline {
    slice ds = get_data().begin_parse();
    return (
        ds~load_uint(256),
        ds~load_uint(64),
        ds~load_uint(256),
        ds~load_msg_addr()
    );
}

() save_data(int pqc_operator_key, int last_seqno, int state_root_hash, slice timelock_address) impure inline {
    set_data(begin_cell()
        .store_uint(pqc_operator_key, 256)
        .store_uint(last_seqno, 64)
        .store_uint(state_root_hash, 256)
        .store_slice(timelock_address)
        .end_cell()
    );
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return ();
    }
    slice sender_address = cs~load_msg_addr();
    force_chain(sender_address);

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    (int pqc_operator_key, int last_seqno, int state_root_hash, slice timelock_address) = load_data();

    ;; op::pqc_attest - Submit and verify Post-Quantum cryptographic state attestation
    if (op == op::pqc_attest()) {
        int seqno = in_msg_body~load_uint(64);
        int expiry = in_msg_body~load_uint(32);
        int action_hash = in_msg_body~load_uint(256);
        int pqc_commitment = in_msg_body~load_uint(256);
        
        cell operator_ref = in_msg_body~load_ref();
        cell payload = in_msg_body~load_ref();

        slice os = operator_ref.begin_parse();
        int operator_pubkey = os~load_uint(256);
        slice operator_sig = os~load_bits(512);

        ;; 1. Invariant: Anti-Replay monotonically increasing seqno
        throw_unless(301, seqno == last_seqno + 1);

        ;; 2. Invariant: Time validity (freshness)
        throw_unless(302, expiry > now());

        ;; 3. Invariant: Action payload matches action_hash
        throw_unless(303, cell_hash(payload) == action_hash);

        ;; 4. Invariant: Operator key authorized
        throw_unless(304, operator_pubkey == pqc_operator_key);

        ;; 5. Invariant: Dual-Attestation verification (Ed25519 envelope over PQC commitment & payload)
        cell attestation_cell = begin_cell()
            .store_uint(op::pqc_attest(), 32)
            .store_uint(seqno, 64)
            .store_uint(expiry, 32)
            .store_uint(action_hash, 256)
            .store_uint(pqc_commitment, 256)
            .store_slice(my_address())
            .end_cell();

        int digest = cell_hash(attestation_cell);
        throw_unless(305, check_signature(digest, operator_sig, operator_pubkey));

        ;; 6. Advance verified state
        int new_state_root = cell_hash(begin_cell()
            .store_uint(state_root_hash, 256)
            .store_uint(pqc_commitment, 256)
            .store_uint(seqno, 64)
            .end_cell()
        );

        save_data(pqc_operator_key, seqno, new_state_root, timelock_address);

        ;; 7. Forward verified payload to timelock / master
        cell fwd_msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(timelock_address)
            .store_coins(0)
            .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(payload)
            .end_cell();
        send_raw_message(fwd_msg, 64);
        return ();
    }

    throw(0xffff);
}

;; Get methods
(int, int, int, slice) get_pqc_gateway_data() method_id {
    (int pqc_operator_key, int last_seqno, int state_root_hash, slice timelock_address) = load_data();
    return (pqc_operator_key, last_seqno, state_root_hash, timelock_address);
}
