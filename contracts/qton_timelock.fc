;; QTON Timelock & 2-of-3 Multisig Governance Controller
;; Standard: 48-Hour Execution Window, Multisig Quorum, Emergency Circuit Breaker
#pragma version >=0.4.0;

#include "imports/stdlib.fc";
#include "params.fc";
#include "op-codes.fc";

;; Storage:
;; admin1_pubkey: uint256
;; delay: uint32
;; is_paused: uint1
;; target_master: MsgAddressInt
;; ref: admins_ref containing admin2_pubkey (uint256) and admin3_pubkey (uint256)
;; dict: proposals

(int, int, int, int, int, slice, cell) load_data() inline {
    slice ds = get_data().begin_parse();
    int admin1 = ds~load_uint(256);
    int delay = ds~load_uint(32);
    int is_paused = ds~load_uint(1);
    slice target_master = ds~load_msg_addr();
    cell admins_ref = ds~load_ref();
    cell proposals = ds~load_dict();
    
    slice as = admins_ref.begin_parse();
    int admin2 = as~load_uint(256);
    int admin3 = as~load_uint(256);

    return (admin1, admin2, admin3, delay, is_paused, target_master, proposals);
}

() save_data(int admin1, int admin2, int admin3, int delay, int is_paused, slice target_master, cell proposals) impure inline {
    cell admins_ref = begin_cell()
        .store_uint(admin2, 256)
        .store_uint(admin3, 256)
        .end_cell();

    set_data(begin_cell()
        .store_uint(admin1, 256)
        .store_uint(delay, 32)
        .store_uint(is_paused, 1)
        .store_slice(target_master)
        .store_ref(admins_ref)
        .store_dict(proposals)
        .end_cell()
    );
}

;; Check admin index (1, 2, 3) from public key, returns 0 if not an authorized admin
int get_admin_index(int pubkey, int a1, int a2, int a3) inline {
    if (pubkey == a1) { return 1; }
    if (pubkey == a2) { return 2; }
    if (pubkey == a3) { return 3; }
    return 0;
}

;; Count number of approvals in mask (3 bits)
int count_approvals(int mask) inline {
    int count = 0;
    if (mask & 1) { count += 1; }
    if (mask & 2) { count += 1; }
    if (mask & 4) { count += 1; }
    return count;
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return ();
    }
    slice sender_address = cs~load_msg_addr();
    force_chain(sender_address);

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    (int a1, int a2, int a3, int delay, int is_paused, slice target_master, cell proposals) = load_data();

    ;; op::emergency_pause - Immediate circuit breaker (requires only 1-of-3 signature/sender)
    if (op == op::emergency_pause()) {
        int signer_pubkey = in_msg_body~load_uint(256);
        slice signature = in_msg_body~load_bits(512);
        cell data_to_sign = begin_cell()
            .store_uint(op::emergency_pause(), 32)
            .store_uint(query_id, 64)
            .store_slice(my_address())
            .end_cell();
        
        throw_unless(401, check_signature(cell_hash(data_to_sign), signature, signer_pubkey));
        int idx = get_admin_index(signer_pubkey, a1, a2, a3);
        throw_unless(403, idx > 0);

        save_data(a1, a2, a3, delay, 1, target_master, proposals);
        return ();
    }

    ;; op::unpause - Unpause requires at least 2-of-3 signatures (second sig in ref)
    if (op == op::unpause()) {
        int signer1_pubkey = in_msg_body~load_uint(256);
        slice sig1 = in_msg_body~load_bits(512);
        cell sig2_ref = in_msg_body~load_ref();
        slice s2 = sig2_ref.begin_parse();
        int signer2_pubkey = s2~load_uint(256);
        slice sig2 = s2~load_bits(512);

        cell data_to_sign = begin_cell()
            .store_uint(op::unpause(), 32)
            .store_uint(query_id, 64)
            .store_slice(my_address())
            .end_cell();
        int hash = cell_hash(data_to_sign);

        throw_unless(401, check_signature(hash, sig1, signer1_pubkey));
        throw_unless(402, check_signature(hash, sig2, signer2_pubkey));
        throw_if(403, signer1_pubkey == signer2_pubkey);

        int idx1 = get_admin_index(signer1_pubkey, a1, a2, a3);
        int idx2 = get_admin_index(signer2_pubkey, a1, a2, a3);
        throw_unless(404, (idx1 > 0) & (idx2 > 0));

        save_data(a1, a2, a3, delay, 0, target_master, proposals);
        return ();
    }

    ;; Check pause invariant: normal governance blocked while system is paused
    throw_if(500, is_paused);

    ;; op::timelock_propose - Propose a new administrative action
    if (op == op::timelock_propose()) {
        int proposer_pubkey = in_msg_body~load_uint(256);
        slice signature = in_msg_body~load_bits(512);
        int proposal_id = in_msg_body~load_uint(64);
        int action_op = in_msg_body~load_uint(32);
        cell payload = in_msg_body~load_ref();

        cell data_to_sign = begin_cell()
            .store_uint(op::timelock_propose(), 32)
            .store_uint(proposal_id, 64)
            .store_uint(action_op, 32)
            .store_uint(cell_hash(payload), 256)
            .end_cell();

        throw_unless(401, check_signature(cell_hash(data_to_sign), signature, proposer_pubkey));
        int idx = get_admin_index(proposer_pubkey, a1, a2, a3);
        throw_unless(403, idx > 0);

        int eta = now() + delay;
        int initial_mask = 1 << (idx - 1);

        cell proposal_cell = begin_cell()
            .store_uint(action_op, 32)
            .store_uint(eta, 32)
            .store_uint(initial_mask, 3)
            .store_uint(0, 1) ;; executed = 0
            .store_ref(payload)
            .end_cell();

        proposals~udict_set_ref(64, proposal_id, proposal_cell);
        save_data(a1, a2, a3, delay, is_paused, target_master, proposals);
        return ();
    }

    ;; op::timelock_approve - Additional admin approves the proposal
    if (op == op::timelock_approve()) {
        int approver_pubkey = in_msg_body~load_uint(256);
        slice signature = in_msg_body~load_bits(512);
        int proposal_id = in_msg_body~load_uint(64);

        cell data_to_sign = begin_cell()
            .store_uint(op::timelock_approve(), 32)
            .store_uint(proposal_id, 64)
            .store_slice(my_address())
            .end_cell();

        throw_unless(401, check_signature(cell_hash(data_to_sign), signature, approver_pubkey));
        int idx = get_admin_index(approver_pubkey, a1, a2, a3);
        throw_unless(403, idx > 0);

        (cell prop_cell, int found) = proposals.udict_get_ref?(64, proposal_id);
        throw_unless(404, found);

        slice ps = prop_cell.begin_parse();
        int action_op = ps~load_uint(32);
        int eta = ps~load_uint(32);
        int mask = ps~load_uint(3);
        int executed = ps~load_uint(1);
        cell payload = ps~load_ref();

        throw_if(405, executed);

        mask |= (1 << (idx - 1));

        cell updated_cell = begin_cell()
            .store_uint(action_op, 32)
            .store_uint(eta, 32)
            .store_uint(mask, 3)
            .store_uint(0, 1)
            .store_ref(payload)
            .end_cell();

        proposals~udict_set_ref(64, proposal_id, updated_cell);
        save_data(a1, a2, a3, delay, is_paused, target_master, proposals);
        return ();
    }

    ;; op::timelock_execute - Execute proposal after timelock delay and 2-of-3 quorum reached
    if (op == op::timelock_execute()) {
        int proposal_id = in_msg_body~load_uint(64);

        (cell prop_cell, int found) = proposals.udict_get_ref?(64, proposal_id);
        throw_unless(404, found);

        slice ps = prop_cell.begin_parse();
        int action_op = ps~load_uint(32);
        int eta = ps~load_uint(32);
        int mask = ps~load_uint(3);
        int executed = ps~load_uint(1);
        cell payload = ps~load_ref();

        ;; Invariants:
        throw_if(405, executed);                       ;; Must not be already executed
        throw_unless(406, now() >= eta);               ;; Timelock delay must have elapsed
        throw_unless(407, count_approvals(mask) >= 2); ;; Must satisfy 2-of-3 multisig quorum

        ;; Mark as executed
        cell updated_cell = begin_cell()
            .store_uint(action_op, 32)
            .store_uint(eta, 32)
            .store_uint(mask, 3)
            .store_uint(1, 1) ;; executed = 1
            .store_ref(payload)
            .end_cell();
        proposals~udict_set_ref(64, proposal_id, updated_cell);
        save_data(a1, a2, a3, delay, is_paused, target_master, proposals);

        ;; Forward call to target_master (QTON Master)
        cell msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(target_master)
            .store_coins(0)
            .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(begin_cell()
                .store_uint(action_op, 32)
                .store_uint(proposal_id, 64)
                .store_slice(payload.begin_parse())
                .end_cell())
            .end_cell();
        send_raw_message(msg, 64); ;; Carry remaining gas
        return ();
    }

    ;; op::timelock_cancel - Cancel proposal (requires 2-of-3 admin consensus)
    if (op == op::timelock_cancel()) {
        int signer1_pubkey = in_msg_body~load_uint(256);
        slice sig1 = in_msg_body~load_bits(512);
        cell sig2_ref = in_msg_body~load_ref();
        slice s2 = sig2_ref.begin_parse();
        int signer2_pubkey = s2~load_uint(256);
        slice sig2 = s2~load_bits(512);
        int proposal_id = in_msg_body~load_uint(64);

        cell data_to_sign = begin_cell()
            .store_uint(op::timelock_cancel(), 32)
            .store_uint(proposal_id, 64)
            .store_slice(my_address())
            .end_cell();
        int hash = cell_hash(data_to_sign);

        throw_unless(401, check_signature(hash, sig1, signer1_pubkey));
        throw_unless(402, check_signature(hash, sig2, signer2_pubkey));
        throw_if(403, signer1_pubkey == signer2_pubkey);

        proposals~udict_delete?(64, proposal_id);
        save_data(a1, a2, a3, delay, is_paused, target_master, proposals);
        return ();
    }

    throw(0xffff);
}

;; Get methods for transparency
(int, int, slice, int, int, int) get_timelock_data() method_id {
    (int a1, int a2, int a3, int delay, int is_paused, slice target_master, _) = load_data();
    return (delay, is_paused, target_master, a1, a2, a3);
}

(int, int, int, int) get_proposal_status(int proposal_id) method_id {
    (_, _, _, _, _, _, cell proposals) = load_data();
    (cell prop_cell, int found) = proposals.udict_get_ref?(64, proposal_id);
    if (~ found) {
        return (-1, 0, 0, 0);
    }
    slice ps = prop_cell.begin_parse();
    int action_op = ps~load_uint(32);
    int eta = ps~load_uint(32);
    int mask = ps~load_uint(3);
    int executed = ps~load_uint(1);
    return (action_op, eta, mask, executed);
}
